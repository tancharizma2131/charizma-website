{
  "name": "charizma-management-site",
  "version": "1.0.0",
  "description": "Static website for Charizma Management.",
  "main": "build.js",
  "type": "module",
  "scripts": {
    "build": "node build.js && node scripts/package-public.js",
    "check": "node check-missing-images.js && node check-digitals.js",
    "watch": "nodemon --watch style.css --watch js/main.js --ext css,js --exec \"node build.js\"",
    "dev:app": "node scripts/serve-app.js",
    "test:auth": "node --test tests/staff-auth.test.js",
    "test:dashboard": "node --test tests/applicants.test.js tests/applicants-ui.test.js",
    "test:applications": "node --test tests/submissions.test.js tests/apply-ui.test.js",
    "test:publication": "npm run build && node --test tests/publication.test.js"
  },
  "dependencies": {
    "glob": "^10.3.10",
    "jsdom": "^24.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "nodemon": "^3.1.0",
    "terser": "^5.43.1"
  }
}
