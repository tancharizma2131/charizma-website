{
  "name": "charizma-image-processing",
  "version": "1.0.0",
  "description": "A script to automate image optimization for the Charizma website.",
  "main": "process-images.js",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "check": "node check-missing-images.js",
    "clean": "node build.js --clean-only",
    "watch": "nodemon --watch style.css --watch js/main.js --ext css,js --exec \"node build.js --skip-images\""
  },
  "dependencies": {
    "glob": "^10.3.10",
    "jsdom": "^24.0.0",
    "sharp": "^0.33.2"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "terser": "^5.43.1",
    "nodemon": "^3.1.0"
  }
}
